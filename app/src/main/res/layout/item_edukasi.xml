<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Image Cover Frame -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp">

            <ImageView
                android:id="@+id/ivEdukasiCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/img_stop_sa"
                android:scaleType="centerCrop" />

            <!-- Duration Badge -->
            <TextView
                android:id="@+id/tvDurasiEdukasi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="12dp"
                android:background="@drawable/bg_badge_yellow"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="5 Menit"
                android:textColor="#A16207"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Details Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Type badge -->
            <TextView
                android:id="@+id/tvTipeEdukasi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Artikel"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#1C398E"
                android:background="@drawable/bg_tag"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:layout_marginBottom="8dp" />

            <!-- Title -->
            <TextView
                android:id="@+id/tvJudulEdukasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mengenali Tanda-Tanda Pelecehan Seksual"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="#1D293D"
                android:lineSpacingMultiplier="1.1"
                android:layout_marginBottom="6dp" />

            <!-- Short description -->
            <TextView
                android:id="@+id/tvDeskripsiEdukasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Jangan panik. Kenali Tanda-Tanda dari pelecehan seksual berikut."
                android:textSize="13sp"
                android:textColor="#64748B"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginBottom="12dp" />

            <!-- Action Link text -->
            <TextView
                android:id="@+id/tvEdukasiAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Baca Selengkapnya →"
                android:textColor="#1C398E"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
