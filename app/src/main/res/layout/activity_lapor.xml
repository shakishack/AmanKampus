<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:background="#1C398E"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/btnBackLapor"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_arrow_back"
                android:clickable="true"
                android:focusable="true"
                app:tint="#FFFFFF"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lapor Kejadian"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toEndOf="@id/btnBackLapor"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageView
                android:id="@+id/btnMenuLapor"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_more"
                android:clickable="true"
                android:focusable="true"
                app:tint="#FFFFFF"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:contentPadding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_shield"
                            app:tint="#1C398E"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Laporkan Anonim"
                                android:textStyle="bold"
                                android:textColor="#1D293D"
                                android:textSize="16sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Identitas Anda akan disembunyikan"
                                android:textSize="12sp"
                                android:textColor="@color/colorTextGray"/>
                        </LinearLayout>

                        <Switch
                            android:id="@+id/switchAnonim"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kategori"
                        android:textStyle="bold"
                        android:textColor="#314158"
                        android:layout_marginBottom="8dp"/>

                    <RelativeLayout
                        android:id="@+id/spinnerKategoriContainer"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_input"
                        android:layout_marginBottom="16dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvSelectedKategori"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="40dp"
                            android:text="Pilih kategori kejadian"
                            android:textColor="#94A3B8"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/ivArrowKategori"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="12dp"
                            android:src="@drawable/ic_arrow_down"
                            app:tint="#62748E" />
                    </RelativeLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kronologi Kejadian"
                        android:textStyle="bold"
                        android:textColor="#314158"
                        android:layout_marginBottom="8dp"/>
                    <EditText
                        android:id="@+id/etKronologi"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:background="@drawable/bg_input"
                        android:hint="Jelaskan kronologi kejadian secara detail..."
                        android:gravity="top|start"
                        android:padding="12dp"
                        android:inputType="textMultiLine"
                        android:minLines="5"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:contentPadding="16dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upload Bukti (Opsional)"
                        android:textStyle="bold"
                        android:textColor="#314158"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:weightSum="3">

                        <LinearLayout
                            android:id="@+id/btnUploadCamera"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_input"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginEnd="6dp">
                            <ImageView
                                android:id="@+id/ivIconCamera"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_camera"
                                app:tint="#45556C"/>
                            <TextView
                                android:id="@+id/tvLabelCamera"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Camera"
                                android:textSize="12sp"
                                android:textColor="#45556C"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnUploadAudio"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_input"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginHorizontal="6dp">
                            <ImageView
                                android:id="@+id/ivIconAudio"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_mic"
                                app:tint="#45556C"/>
                            <TextView
                                android:id="@+id/tvLabelAudio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Audio"
                                android:textSize="12sp"
                                android:textColor="#45556C"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnUploadImage"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_input"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginStart="6dp">
                            <ImageView
                                android:id="@+id/ivIconImage"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_image"
                                app:tint="#45556C"/>
                            <TextView
                                android:id="@+id/tvLabelImage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Image"
                                android:textSize="12sp"
                                android:textColor="#45556C"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btnKirimLaporan"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Kirim Laporan Aman"
                android:backgroundTint="@color/colorPrimary"
                android:textColor="#FFFFFF"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Laporan Anda akan ditangani dengan profesional dan rahasia"
                android:textAlignment="center"
                android:textSize="12sp"
                android:textColor="@color/colorTextGray"
                android:layout_marginTop="8dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>