<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_popup_darurat"
    android:padding="32dp"
    android:gravity="center"
    android:layout_gravity="center">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_warning"
        android:layout_marginBottom="16dp"
        app:tint="#FB2C36"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Peringatan"
        android:textColor="#1D293D"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Panggilan Darurat telah diaktifkan. Lokasi Anda telah dibagikan ke pihak keamanan."
        android:textColor="#45556C"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:textAlignment="center"/>

    <Button
        android:id="@+id/btnLanjutkan"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Lanjutkan"
        android:backgroundTint="#1C398E"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:layout_marginTop="24dp"/>

</LinearLayout>